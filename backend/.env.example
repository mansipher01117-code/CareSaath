# Copy to backend/.env and fill in. backend/.env is gitignored — never commit a key.

# ---- Gemini (the LLM that answers questions in the Ask screen) ----
# Free API key: https://aistudio.google.com/apikey
# Without a key the agent still answers, from the deterministic rules engine
# ("engine": "rules" in the response) — nothing breaks, the answers are just
# templated instead of written.
GEMINI_API_KEY=
# Any current free-tier Flash model. gemini-flash-latest tracks the newest one;
# pin an exact id (e.g. gemini-3.8-flash) if you want it to stop moving.
GEMINI_MODEL=gemini-flash-latest

# ---- FalkorDB ----
# FALKORDB_EMBEDDED=0 means "use a server". Default: the one from
# docker-compose.yml on localhost:6379, which needs no credentials.
# FALKORDB_HOST=localhost
# FALKORDB_PORT=6379
# A managed/cloud FalkorDB also needs these two (leave empty for a local one):
# FALKORDB_USERNAME=falkordb
# FALKORDB_PASSWORD=

# Embedded engine instead of a server, when Docker isn't available:
# pip install falkordblite, then set FALKORDB_EMBEDDED=1.
# Linux/macOS only — redislite does not build on Windows.
FALKORDB_EMBEDDED=0
FALKORDB_LITE_PATH=./data/caresaath.db

# ---- API ----
# Comma-separated browser origins allowed to call the API. "*" for local work;
# set it to the deployed frontend's origin in production, e.g.
# ALLOWED_ORIGINS=https://caresaath.vercel.app
ALLOWED_ORIGINS=*
